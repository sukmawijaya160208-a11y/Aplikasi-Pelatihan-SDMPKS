# ============================================================
# SDMPKS - Caching & keamanan dasar
# Aset statis di-cache 7 hari (versi ?v= mengendalikan invalidasi);
# halaman HTML & API tetap tanpa cache agar data selalu segar.
# ============================================================
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # ---- Security / hardening headers (lapisan Apache/XAMPP) ----
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-XSS-Protection "1; mode=block"

  # ---- Content Security Policy ----
  # Script hanya dari situs sendiri + CDN yang diizinkan (tanpa 'unsafe-inline').
  # Style inline tetap diizinkan karena kode UI menggunakan attribute style.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

  # Sembunyikan versi server web
  Header unset X-Powered-By
  Header always unset Server
</IfModule>

Options -Indexes

# ============================================================
# Paksa HTTPS (redirect 301 dari http:// ke https://)
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ============================================================
# SDMPKS - Batas unggah dokumen
# Berlaku hanya bila PHP berjalan sebagai modul Apache
# (mod_php). Aman diabaikan pada server PHP-FPM/nginx;
# untuk server tersebut naikkan di php.ini (upload_max_filesize,
# post_max_size) dan client_max_body_size di konfigurasi nginx.
# ============================================================
<IfModule mod_php8.c>
  php_value upload_max_filesize 20M
  php_value post_max_size 24M
  php_value max_file_uploads 20
  php_value display_errors 0
  php_value log_errors 1
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 20M
  php_value post_max_size 24M
  php_value max_file_uploads 20
  php_value display_errors 0
  php_value log_errors 1
</IfModule>
<IfModule mod_php.c>
  php_value upload_max_filesize 20M
  php_value post_max_size 24M
  php_value max_file_uploads 20
  php_value display_errors 0
  php_value log_errors 1
</IfModule>
