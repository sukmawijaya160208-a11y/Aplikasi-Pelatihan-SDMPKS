# ============================================================
# SDMPKS - Berkas yang TIDAK boleh masuk repository
# ============================================================

# Konfigurasi database lokal (berisi kredensial)
# Salin api/config.example.php -> api/config.php lalu isi sesuai lingkungan
api/config.php

# Backup database + dokumen hasil fitur Backup & Restore (berisi data produksi)
backups/*.sql
backups/*.zip
!backups/.htaccess

# Dokumen unggahan pengguna (PDF berkas pekebun)
uploads/pekebun/
!uploads/pekebun/.htaccess

# Folder dokumen cadangan hasil restore backup (dihasilkan runtime, bukan bagian repo)
uploads/pekebun_old_*/

# Sampah OS / editor
Thumbs.db
Desktop.ini
*.log
.vscode/
.idea/
node_modules/

# State sementara keamanan (rate-limit, audit log) - data runtime
storage/ratelimit/
storage/audit.log
!storage/.htaccess

# Artefak uji lokal / debug
resp.txt
resp_dash.txt
resp_dash2.txt

# Sumber favicon (salinan final di assets/img/favicon.ico)
foto_icon/

# Artefak uji otomatis
*.cjs.dbg

# Cache Python dari skill opencode
__pycache__/
*.pyc
